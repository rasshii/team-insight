# docker-compose.yml が読み込むルート .env のテンプレート
# 開発環境では未設定でも docker-compose.yml の ${VAR:-default} で起動可能だが、
# 本番環境では必ず強力な値で上書きすること。
#
# 強力な値の生成例:
#   openssl rand -base64 32

# PostgreSQL
POSTGRES_USER=team_insight_user
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=team_insight

# Redis
REDIS_PASSWORD=change-me-in-production

# Backend (任意で上書き)
# DEBUG=False
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TLS=true
# SMTP_FROM_EMAIL=noreply@teaminsight.dev
